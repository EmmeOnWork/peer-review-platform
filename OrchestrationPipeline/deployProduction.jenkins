sshagent(credentials: [env.GIT_CREDENTIALS_ID]) {
    def NAMESPACE = 'production'

    // Funzione per verificare se una directory esiste
    def dirExists = { String dirName ->
        fileExists(dirName)
    }
    // Funzione per ottenere la lista dei servizi backend
    def getBackendList = {
        if (fileExists('Backend')) {
            return sh(script: "ls Backend", returnStdout: true).trim().split('\n')
        }
        return []
    }
    // Funzione per verificare se esistono file yaml in una directory
    def yamlFilesInDir = { String k8sPath ->
        if (fileExists(k8sPath)) {
            def files = sh(script: "ls ${k8sPath}/*.yaml 2>/dev/null || true", returnStdout: true).trim().split('\n')
            return files.findAll { it?.trim() }
        }
        return []
    }

    // Crea namespace se non esiste
    sh "microk8s kubectl get namespace ${NAMESPACE} || microk8s kubectl create namespace ${NAMESPACE}"

    // Deploy di tutti i servizi (Frontend + Backend)
    def serviceDirs = []
    if (dirExists('Frontend')) {
        serviceDirs << 'Frontend'
    }
    def backendList = getBackendList()
    backendList.each { svc ->
        serviceDirs << "Backend/${svc}"
    }
    if (serviceDirs.isEmpty()) {
        error "Nessun servizio trovato per il deploy. Pipeline interrotta."
    }
    echo "Servizi trovati: ${serviceDirs.join(', ')}"
    serviceDirs.each { service ->
        def k8sPath = "${service}/k8s/production"
        def yamlFiles = yamlFilesInDir(k8sPath)
        if (!yamlFiles || yamlFiles.size() == 0) {
            error "Nessun file .yaml trovato in ${k8sPath}. Pipeline interrotta."
        }
        yamlFiles.each { file ->
            echo "Aplico ${file} su ${NAMESPACE}..."
            sh "microk8s kubectl apply -f ${file} --namespace=${NAMESPACE}"
        }
    }
    // Applica Ingress già presente nella cartella Ingress
    def ingressFile = "Ingress/ingress_production.yaml"
    if (fileExists(ingressFile)) {
        echo "Applico Ingress da ${ingressFile}..."
        sh "microk8s kubectl apply -f ${ingressFile} --namespace=${NAMESPACE}"
    } else {
        error "File ${ingressFile} non trovato. Pipeline interrotta."
    }

    // Rollout restart di tutti i deployment nel namespace
    echo "Eseguo rollout restart di tutti i deployment su ${NAMESPACE}..."
    sh "microk8s kubectl rollout restart deployment -n ${NAMESPACE}"

    // Avvia il rollout status con timeout
    def deployments = sh(
        script: "microk8s kubectl get deployments -n ${NAMESPACE} -o jsonpath='{.items[*].metadata.name}'",
        returnStdout: true
    ).trim().split(' ')

    deployments.each { dep ->
        if (dep?.trim()) {
            echo "Attendo completamento rollout per deployment: ${dep}"
            sh "microk8s kubectl rollout status deployment/${dep} -n ${NAMESPACE} --timeout=1200s" // 20 minuti
        }
    }

    echo "Tutti i deployment sono stati aggiornati su ${NAMESPACE}. Deploy produzione completato."
}
