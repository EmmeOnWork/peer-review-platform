sshagent(credentials: [env.GIT_CREDENTIALS_ID]) {
    def NAMESPACE = 'pre-release'

    // Funzione per verificare se una directory esiste
    def dirExists = { String dirName ->
        fileExists(dirName)
    }
    // Funzione per ottenere la lista dei servizi backend
    def getBackendList = {
        if (fileExists('Backend')) {
            return sh(script: "ls Backend", returnStdout: true).trim().split('\n')
        }
        return []
    }
    // Funzione per verificare se esistono file yaml in una directory
    def yamlFilesInDir = { String k8sPath ->
        if (fileExists(k8sPath)) {
            def files = sh(script: "ls ${k8sPath}/*.yaml 2>/dev/null || true", returnStdout: true).trim().split('\n')
            return files.findAll { it?.trim() }
        }
        return []
    }

    try {
        echo "Inizio deploy nel namespace '${NAMESPACE}'"
        // Crea namespace se non esiste
        sh "microk8s kubectl create namespace ${NAMESPACE} || microk8s kubectl get namespace ${NAMESPACE} || true"
        // Raccoglie i servizi Frontend e Backend
        def serviceDirs = []
        if (dirExists('Frontend')) {
            serviceDirs << 'Frontend'
        }
        def backendList = getBackendList()
        backendList.each { svc ->
            serviceDirs << "Backend/${svc}"
        }
        if (serviceDirs.isEmpty()) {
            error "Nessun servizio trovato per il deploy. Pipeline interrotta."
        }
        echo "Servizi trovati: ${serviceDirs.join(', ')}"
        // Deploy per ciascun servizio
        serviceDirs.each { service ->
            def k8sPath = "${service}/k8s/production"
            def yamlFiles = yamlFilesInDir(k8sPath)
            if (!yamlFiles || yamlFiles[0] == '') {
                error "Nessun file .yaml trovato in ${k8sPath}."
            }
            yamlFiles.each { file ->
                echo "Applico ${file} su ${NAMESPACE}..."
                sh "microk8s kubectl apply -f ${file} --namespace=${NAMESPACE}"
            }
        }
        // Applica Ingress già presente nella cartella Ingress
        def ingressFile = "Ingress/ingress_pre-release.yaml"
        if (fileExists(ingressFile)) {
            echo "Applico Ingress da ${ingressFile}..."
            sh "microk8s kubectl apply -f ${ingressFile} --namespace=${NAMESPACE}"
        } else {
            error "File ${ingressFile} non trovato. Pipeline interrotta."
        }
        // Attesa stato Running e nessun restart
        timeout(time: 5, unit: 'MINUTES') {
            waitUntil {
                def podStatus = sh(script: "microk8s kubectl get pods --namespace=${NAMESPACE} --no-headers", returnStdout: true).trim()
                if (!podStatus) {
                    echo "Nessun pod trovato. Attendo..."
                    return false
                }
                def allOk = podStatus.readLines().every {
                    def cols = it.split()
                    return cols[2] == 'Running' && cols[1].startsWith('1/') && cols[3] == '0'
                }
                if (!allOk) {
                    echo "Alcuni pod non sono ancora Running o hanno restart. Attendo..."
                }
                return allOk
            }
        }
        // Verifica finale
        def notRunningPods = sh(
            script: "microk8s kubectl get pods --namespace=${NAMESPACE} --no-headers | awk '\$3 != \"Running\" {print \$1, \$3}' || true",
            returnStdout: true
        ).trim()
        if (notRunningPods) {
            error "Alcuni pod non sono in stato Running dopo il deploy:\n${notRunningPods}"
        }
        echo "Tutti i pod sono in stato Running su ${NAMESPACE}. Deploy completato."
    } catch (Exception e) {
        echo "Errore durante il deploy su ${NAMESPACE}: ${e.message}"
        echo "Pulizia risorse nel namespace ${NAMESPACE}..."
        sh "microk8s kubectl delete namespace ${NAMESPACE} --wait=true || true"
        error("Deploy fallito. Pipeline terminata.")
    }
}

