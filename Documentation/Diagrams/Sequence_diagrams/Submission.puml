@startuml
title Sequence Diagram - Student Submits Work

actor Student
participant "Vue.js SPA\n(in Browser)" as FrontendApp
participant "NGINX Ingress Controller" as Ingress
participant "Submission Service Pod" as SubmissionServicePod
participant "Assignment Service Pod" as AssignmentServicePod
database "MongoDB\n(Submissions DB)" as DBSubmission
participant "MinIO Pod" as MinIO

Student -> FrontendApp: Selects assignment, uploads file(s), and submits
activate FrontendApp

FrontendApp -> Ingress: **POST /submissions** (HTTPS)\n{multipart/form-data, header: Auth: Bearer **jwt**}
activate Ingress

note right of Ingress
  **Path-Based Routing:**
  Path "/submissions" matches the rule
  for the Submission Service.
end note

Ingress -> SubmissionServicePod: **POST /submissions** (HTTP)\n{...}, Header: Auth: Bearer **jwt**
activate SubmissionServicePod

' Step 1: JWT Validation and get student's serial number
SubmissionServicePod -> SubmissionServicePod: Decode token & check claims (role, exp, serialNumber)
alt#LightCoral #White Invalid Token or Role != 'student'
    SubmissionServicePod --> Ingress: HTTP 401/403 Response
    deactivate SubmissionServicePod
    Ingress --> FrontendApp: HTTP 401/403 Response
    deactivate Ingress
    FrontendApp -> Student: Show Error Message
    deactivate FrontendApp
end

' Step 2: Validate assignment, deadline, and student enrollment
note right of SubmissionServicePod
  Calls Assignment service to check deadline
  and verify the student is part of the assignment.
end note
SubmissionServicePod -> Ingress: **GET /assignments/{assignmentId}** (HTTP)\nHeader: Auth: Bearer **jwt**
activate Ingress
Ingress -> AssignmentServicePod: **GET /assignments/{assignmentId}** (HTTP)
activate AssignmentServicePod
AssignmentServicePod --> Ingress: HTTP 200 {assignment_details} / HTTP 404/403
deactivate AssignmentServicePod
Ingress --> SubmissionServicePod: HTTP 200 {assignment_details} / HTTP 404/403
deactivate Ingress

alt#LightCoral #White Assignment Not Found, Deadline Passed, or Student Not Enrolled
    SubmissionServicePod -> SubmissionServicePod: Validate student is in assignment.students list
    SubmissionServicePod --> Ingress: HTTP 404/403 Response\n{"error": "Assignment not available or deadline passed."}
    deactivate SubmissionServicePod
    Ingress --> FrontendApp: HTTP 404/403 Response
    FrontendApp -> Student: Show Error Message
    deactivate FrontendApp
end

' Step 3: Check if student has already submitted
SubmissionServicePod -> DBSubmission: findOne({assignmentId, studentSerialNumber})
activate DBSubmission
DBSubmission --> SubmissionServicePod: Existing submission / null
deactivate DBSubmission

alt#Gold #White Student has already submitted
    SubmissionServicePod --> Ingress: HTTP 400\n{"error": "You have already submitted for this assignment."}
    deactivate SubmissionServicePod
    Ingress --> FrontendApp: HTTP 400 Response
    FrontendApp -> Student: Show Error Message
    deactivate FrontendApp
end

' Step 4: Upload file attachments to MinIO (S3-compatible storage)
loop for each file in the request
    SubmissionServicePod -> MinIO: **PUT object (file stream)**\n(Internal S3 SDK call)
    activate MinIO
    MinIO --> SubmissionServicePod: Success confirmation (object URL/key)
    deactivate MinIO
end

' Step 5: Save submission metadata to database
SubmissionServicePod -> SubmissionServicePod: build_submission_object(...)
SubmissionServicePod -> DBSubmission: insert_one(submission_object)
activate DBSubmission
DBSubmission --> SubmissionServicePod: {mongo_object_id}
deactivate DBSubmission

' Step 6: Return success response
SubmissionServicePod --> Ingress: **HTTP 201 Created**\n{final_submission_object}
deactivate SubmissionServicePod

Ingress --> FrontendApp: **HTTPS 201 Created**\n{final_submission_object}
deactivate Ingress

FrontendApp -> Student: Display "Submission successful!" confirmation
deactivate FrontendApp

@enduml