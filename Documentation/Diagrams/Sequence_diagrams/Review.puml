@startuml
title Sequence Diagram - Teacher Auto-Assigns Peer Reviews

actor Teacher
participant "Vue.js SPA\n(in Browser)" as FrontendApp
participant "NGINX Ingress Controller" as Ingress
participant "Review Service Pod" as ReviewServicePod
participant "Assignment Service Pod" as AssignmentServicePod
participant "Submission Service Pod" as SubmissionServicePod
participant "Authentication Service Pod" as AuthServicePod
database "MongoDB\n(Reviews DB)" as DBReview

Teacher -> FrontendApp: Selects assignment, clicks "Auto-Assign Reviews"
activate FrontendApp

FrontendApp -> Ingress: **POST /reviews/assign/auto** (HTTPS)\n{assignmentId, minReviews}, Header: Auth: Bearer **jwt**
activate Ingress

note right of Ingress
  **Path-Based Routing:**
  Path "/reviews/assign/auto" matches
  the rule for the Review Service.
end note

Ingress -> ReviewServicePod: **POST /reviews/assign/auto** (HTTP)\n{...}, Header: Auth: Bearer **jwt**
activate ReviewServicePod

' Step 1: JWT Validation and Role Check (local)
ReviewServicePod -> ReviewServicePod: Decode token & check claims (role, exp)
alt#LightCoral #White Invalid Token or Role != 'teacher'
    ReviewServicePod --> Ingress: HTTP 401/403 Response
    deactivate ReviewServicePod
    Ingress --> FrontendApp: HTTP 401/403 Response
    deactivate Ingress
    FrontendApp -> Teacher: Show Error Message
    deactivate FrontendApp
end

' Step 2: Get assignment details to verify ownership and get student list
ReviewServicePod -> Ingress: **GET /assignments/{assignmentId}** (HTTP)\nHeader: Auth: Bearer **jwt**
activate Ingress
Ingress -> AssignmentServicePod: **GET /assignments/{assignmentId}** (HTTP)
activate AssignmentServicePod
AssignmentServicePod --> Ingress: HTTP 200 {assignment_details} / HTTP 404/403
deactivate AssignmentServicePod
Ingress --> ReviewServicePod: HTTP 200 {assignment_details} / HTTP 404/403
deactivate Ingress

alt#LightCoral #White Assignment Not Found or Not Owner
    ReviewServicePod --> Ingress: HTTP 404/403 Response
    deactivate ReviewServicePod
    Ingress --> FrontendApp: HTTP 404/403 Response
    FrontendApp -> Teacher: Show Error Message
    deactivate FrontendApp
end

' Step 3: Get all submissions for the assignment
ReviewServicePod -> Ingress: **GET /submissions?assignmentId={id}** (HTTP)\nHeader: Auth: Bearer **jwt**
activate Ingress
Ingress -> SubmissionServicePod: **GET /submissions?assignmentId={id}** (HTTP)
activate SubmissionServicePod
SubmissionServicePod --> Ingress: HTTP 200 [{submission}, ...]
deactivate SubmissionServicePod
Ingress --> ReviewServicePod: HTTP 200 [{submission}, ...]
deactivate Ingress

alt#Gold #White No submissions found
    note right of ReviewServicePod: If submission list is empty, stop process.
    ReviewServicePod --> Ingress: HTTP 400\n{"error": "No submissions to review"}
    deactivate ReviewServicePod
    Ingress --> FrontendApp: HTTP 400 Response
    FrontendApp -> Teacher: Show "No submissions found" message
    deactivate FrontendApp
end

' Step 4: Internal logic to create review pairings
group Internal Logic
    ReviewServicePod -> ReviewServicePod: Run assignment algorithm using student list\nfrom assignment details and submission list.\n(Avoids self-review)
end

' Step 5: Save new review assignments to DB
ReviewServicePod -> DBReview: insert_many(new_review_assignments)
activate DBReview
DBReview --> ReviewServicePod: {inserted_ids}
deactivate DBReview

' Step 6: Prepare and send final response
ReviewServicePod --> Ingress: **HTTP 200 OK**\n[{createdReview}, ...]
deactivate ReviewServicePod

Ingress --> FrontendApp: **HTTPS 200 OK**\n[{createdReview}, ...]
deactivate Ingress
FrontendApp -> Teacher: Display confirmation of assigned reviews
deactivate FrontendApp

@enduml
